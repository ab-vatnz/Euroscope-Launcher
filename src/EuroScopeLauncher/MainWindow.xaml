<Window x:Class="EuroScopeLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EuroScope Launcher" Height="620" Width="940" MinHeight="560" MinWidth="820" WindowStartupLocation="CenterScreen" Background="#FAFAFA">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="12,11"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="#E3E3E3"/><Setter Property="BorderBrush" Value="#888"/></Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
      <Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" VerticalAlignment="Center"><TextBlock Text="EuroScope" FontSize="37" FontWeight="Bold" Foreground="#252525"/><TextBlock Text="L A U N C H E R" FontSize="16" FontWeight="SemiBold" Foreground="#188A83" Margin="4,0,0,0"/><TextBlock Text="VATNZ controller tools" Foreground="#777" Margin="3,8,0,0"/></StackPanel>
      <Button Grid.Row="1" Style="{StaticResource NavButton}" Content="Home" Tag="Home" Click="Nav_Click"/>
      <Button Grid.Row="2" Style="{StaticResource NavButton}" Content="Profiles" Tag="Profiles" Click="Nav_Click"/>
      <Button Grid.Row="3" Style="{StaticResource NavButton}" Content="Plugins" Tag="Plugins" Click="Nav_Click"/>
      <Button Grid.Row="4" Style="{StaticResource NavButton}" Content="Setup" Tag="Setup" Click="Nav_Click"/>
      <TextBlock Grid.Row="6" x:Name="VersionText" HorizontalAlignment="Center" Foreground="#666"/>
    </Grid>
    <Grid Grid.Column="2">
      <Grid x:Name="HomeView">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Home" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="New Zealand EuroScope profile" Foreground="#666" Margin="0,3,0,24"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" Padding="26" CornerRadius="3"><StackPanel><TextBlock Text="New Zealand — NZZC" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="HomeAiracText" FontSize="16" Margin="0,12,0,0"/><TextBlock Text="Sector files are kept in AIRAC. Settings and PRF files are controller-owned and never updated after migration." TextWrapping="Wrap" Foreground="#666" Margin="0,14,0,0"/></StackPanel></Border>
        <StackPanel Grid.Row="2" Margin="0,20,0,0"><Button Content="Launch EuroScope" Background="#9CE77B" FontWeight="SemiBold" FontSize="16" Padding="14,10" Click="Launch_Click"/><TextBlock x:Name="StatusText" Foreground="#666" Margin="0,10,0,0"/></StackPanel>
      </Grid>
      <Grid x:Name="ProfilesView" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Profiles" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Available controller profiles" Foreground="#666" Margin="0,3,0,24"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="New Zealand" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="NZZC" Foreground="#666"/><TextBlock Text="The only currently supported profile." Foreground="#777" Margin="0,8,0,0"/></StackPanel><TextBlock Grid.Column="1" x:Name="ProfileVersionText" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/><Button Grid.Column="2" Content="Update" Padding="12,6" VerticalAlignment="Center" Click="UpdateAirac_Click"/></Grid></Border>
      </Grid>
      <Grid x:Name="PluginsView" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Plugins" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Install, update, or remove EuroScope add-ons" Foreground="#666" Margin="0,3,0,16"/></StackPanel>
        <Button Grid.Row="1" x:Name="RefreshPluginsButton" Content="Refresh plugin list" HorizontalAlignment="Left" Padding="14,7" Click="RefreshPlugins_Click"/>
        <ListBox Grid.Row="2" x:Name="PluginList" Margin="0,12,0,0" Background="White" BorderBrush="#D9D9D9"><ListBox.ItemTemplate><DataTemplate><Border Padding="12" BorderBrush="#E2E2E2" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding InstalledVersion, StringFormat=Installed: {0}}" Margin="0,4,0,0"/><TextBlock Text="{Binding LatestVersion, StringFormat=Latest release: {0}}" Foreground="#666"/><TextBlock Text="{Binding PostInstallInstructions}" TextWrapping="Wrap" Foreground="#777" Margin="0,4,0,8"/><WrapPanel><Button Content="{Binding InstallAction}" Tag="{Binding}" Padding="12,5" Margin="0,0,8,0" Click="InstallPlugin_Click"/><Button Content="Uninstall" Tag="{Binding}" Padding="12,5" Click="UninstallPlugin_Click" IsEnabled="{Binding IsInstalled}"/></WrapPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid>
      <Grid x:Name="SetupView" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Setup" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="EuroScope location and AIRAC management" Foreground="#666" Margin="0,3,0,20"/></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock Text="EuroScope executable" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,18"><Button DockPanel.Dock="Right" Content="Browse…" Padding="16,5" Click="Browse_Click"/><TextBox x:Name="EuroScopePathBox" Margin="0,0,8,0" IsReadOnly="True"/></DockPanel></StackPanel>
        <WrapPanel Grid.Row="2"><Button Content="First-time SkyLine setup" Padding="14,7" Margin="0,0,8,8" Click="Setup_Click"/><Button Content="Check / update AIRAC" Padding="14,7" Margin="0,0,8,8" Click="UpdateAirac_Click"/><Button Content="Check launcher update" Padding="14,7" Margin="0,0,8,8" Click="CheckAppUpdate_Click"/></WrapPanel>
        <TextBlock Grid.Row="3" x:Name="AiracStatusText" TextWrapping="Wrap" Foreground="#666" Margin="0,14,0,0"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
