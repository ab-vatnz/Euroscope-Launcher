<Window x:Class="EuroScopeLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EuroScope Launcher" Height="610" Width="820" MinHeight="540" MinWidth="700" WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="EuroScope Launcher" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="VATNZ AIRAC, plugin, and EuroScope launch manager" Foreground="DimGray" Margin="0,4,0,16"/>
    </StackPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Setup &amp; AIRAC"><StackPanel Margin="18">
        <TextBlock Text="EuroScope executable" FontWeight="SemiBold"/>
        <DockPanel Margin="0,6,0,14"><Button DockPanel.Dock="Right" Content="Browse…" Padding="16,5" Click="Browse_Click"/><TextBox x:Name="EuroScopePathBox" Margin="0,0,8,0" IsReadOnly="True"/></DockPanel>
        <TextBlock x:Name="AiracStatusText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <WrapPanel><Button Content="First-time SkyLine setup" Padding="14,7" Margin="0,0,8,8" Click="Setup_Click"/><Button Content="Check / update AIRAC" Padding="14,7" Margin="0,0,8,8" Click="UpdateAirac_Click"/></WrapPanel>
        <TextBlock Text="First-time setup downloads the full SkyLine package once. Later updates only replace SCT2, ESE and RWY files—never your PRF, plugins, or settings." TextWrapping="Wrap" Foreground="DimGray" Margin="0,10,0,0"/>
      </StackPanel></TabItem>
      <TabItem Header="Plugins"><StackPanel Margin="18">
        <TextBlock Text="Supported plugins are installed into AIRAC\Plugins. New or updated plugins must be enabled in EuroScope before use." TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Button x:Name="RefreshPluginsButton" Content="Load plugin catalog" HorizontalAlignment="Left" Padding="14,7" Click="RefreshPlugins_Click"/>
        <ListBox x:Name="PluginList" Margin="0,12,0,0" MinHeight="210"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding InstalledVersion, StringFormat=Installed: {0}}" Margin="0,4,0,0"/><TextBlock Text="{Binding LatestVersion, StringFormat=Latest release: {0}}" Foreground="DimGray"/><TextBlock Text="{Binding PostInstallInstructions}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,6"/><WrapPanel><Button Content="{Binding InstallAction}" Tag="{Binding}" Padding="12,5" Margin="0,0,8,0" Click="InstallPlugin_Click"/><Button Content="Uninstall" Tag="{Binding}" Padding="12,5" Click="UninstallPlugin_Click" IsEnabled="{Binding IsInstalled}"/></WrapPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      </StackPanel></TabItem>
      <TabItem Header="Launcher updates"><StackPanel Margin="18">
        <TextBlock x:Name="AppUpdateText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Button Content="Check for launcher update" HorizontalAlignment="Left" Padding="14,7" Click="CheckAppUpdate_Click"/>
      </StackPanel></TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="DimGray" Text="Ready."/><Button DockPanel.Dock="Right" Content="Launch EuroScope" Padding="18,8" FontWeight="SemiBold" Click="Launch_Click"/></DockPanel>
  </Grid>
</Window>
