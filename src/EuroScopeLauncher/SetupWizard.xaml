<Window x:Class="EuroScopeLauncher.SetupWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Welcome to EuroScope Launcher" Height="490" Width="720" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FAFAFA">
  <Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="WelcomePage"><StackPanel VerticalAlignment="Center"><TextBlock Text="Welcome to EuroScope Launcher" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="A simple guided setup for VATNZ EuroScope sector files, profiles, and plugins." FontSize="17" TextWrapping="Wrap" Foreground="#666" Margin="0,14,0,0"/></StackPanel></Grid>
    <Grid x:Name="DetectPage" Visibility="Collapsed"><StackPanel VerticalAlignment="Center"><TextBlock Text="Find your EuroScope installation" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="EuroScope Launcher will use this executable. Change it if your installation is elsewhere." TextWrapping="Wrap" Foreground="#666" Margin="0,12,0,16"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Padding="14,5" Click="Browse_Click"/><TextBox x:Name="PathBox" Margin="0,0,8,0" IsReadOnly="True"/></DockPanel><TextBlock x:Name="DetectionText" TextWrapping="Wrap" Margin="0,18,0,0" Foreground="#555"/></StackPanel></Grid>
    <Grid x:Name="MigratePage" Visibility="Collapsed"><StackPanel VerticalAlignment="Center"><TextBlock Text="Keep your controller settings" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="MigrationText" TextWrapping="Wrap" Foreground="#555" Margin="0,14,0,0"/><TextBlock Text="The launcher will never replace or update Settings or PRF files after this step." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Grid>
    <Grid x:Name="ReadyPage" Visibility="Collapsed"><StackPanel VerticalAlignment="Center"><TextBlock Text="You’re ready to finish setup" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="The main launcher will now let you install the current New Zealand sector files and manage plugins. Select the SCT2 file in EuroScope after the first update." TextWrapping="Wrap" Foreground="#555" Margin="0,14,0,0"/></StackPanel></Grid>
    <DockPanel Grid.Row="1" Margin="0,28,0,0"><TextBlock x:Name="StepText" VerticalAlignment="Center" Foreground="#777"/><Button x:Name="NextButton" DockPanel.Dock="Right" Content="Get started" Padding="20,8" Click="Next_Click"/></DockPanel>
  </Grid>
</Window>
